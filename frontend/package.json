{
  "name": "reknyx-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/model.test.ts",
    "test:contract": "tsx --test tests/api-mappers.test.ts",
    "test:e2e": "playwright test",
    "generate:api": "node scripts/generate-api.mjs",
    "test:api": "playwright test --config playwright.api.config.ts",
    "test:client": "tsx --test tests/api-client.test.ts"
  },
  "dependencies": {
    "@fontsource/manrope": "5.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "lucide-react": "1.68.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
