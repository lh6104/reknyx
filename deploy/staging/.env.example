# Copy to deploy/staging/.env with mode 0600. Never commit the populated file.
# Use one hostname, without scheme, path or port, with DNS pointing at the host.
REKNYX_STAGING_HOST=staging.example.com

# Every image must use a reviewed registry digest, not a mutable tag.
# Frontend must be built in API mode with backend origin http://api:8000.
REKNYX_BACKEND_IMAGE=
REKNYX_FRONTEND_IMAGE=
REKNYX_POSTGRES_IMAGE=
REKNYX_PROXY_IMAGE=

# Distinct random passwords, at least 24 characters each.
# URL-encode passwords in the connection URLs, preserving the same actual bytes.
REKNYX_POSTGRES_PASSWORD=
REKNYX_RUNTIME_PASSWORD=
REKNYX_MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@db:5432/reknyx
REKNYX_RUNTIME_DATABASE_URL=postgresql+psycopg://reknyx_app:CHANGE_ME@db:5432/reknyx

# Use reknyx.infrastructure.auth.hash_password in a private setup process.
# Single-quote the entire hash in this file to preserve literal dollar signs.
REKNYX_PASSWORD_HASH=
