# Copy to an ignored .env, use unique secrets, and URL-encode DB passwords in URLs.
# Compose database hostname is db. Never use owner credentials for API/worker.
REKNYX_POSTGRES_PASSWORD=
REKNYX_RUNTIME_PASSWORD=
REKNYX_MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@db:5432/reknyx
REKNYX_RUNTIME_DATABASE_URL=postgresql+psycopg://reknyx_app:CHANGE_ME@db:5432/reknyx
# Generate with reknyx.infrastructure.auth.hash_password; quote literal $ in .env.
REKNYX_PASSWORD_HASH=

# Explicit evidence-review mode. Default uses local rules and no external model.
REKNYX_ANALYSIS_PROVIDER=deterministic
# Use a Groq free-plan account; no paid upgrade or provider fallback is automatic.
REKNYX_GROQ_API_KEY=
REKNYX_GROQ_FREE_PLAN_CONFIRMED=false
# Set true only for synthetic evidence covered for Groq transmission.
REKNYX_GROQ_SYNTHETIC_ENABLED=false

# Select explicitly; the application never silently switches models.
REKNYX_GROQ_MODEL=openai/gpt-oss-120b
REKNYX_GROQ_TEMPERATURE=0.1
REKNYX_GROQ_REASONING_EFFORT=low
REKNYX_GROQ_MAX_OUTPUT_TOKENS=1024
