# Copy to an ignored .env, use unique secrets, and URL-encode DB passwords in URLs.
# Compose database hostname is db. Never use owner credentials for API/worker.
REKNYX_POSTGRES_PASSWORD=
REKNYX_RUNTIME_PASSWORD=
REKNYX_MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@db:5432/reknyx
REKNYX_RUNTIME_DATABASE_URL=postgresql+psycopg://reknyx_app:CHANGE_ME@db:5432/reknyx
# Generate with reknyx.infrastructure.auth.hash_password; quote literal $ in .env.
REKNYX_PASSWORD_HASH=
